# Copy this file to .env and replace each placeholder. Never commit .env.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com
AZURE_OPENAI_API_KEY=replace-with-your-key
# Recommended underlying model: gpt-5-nano.
# This value is your Azure deployment name, for example: routelab-gpt-5-nano
AZURE_OPENAI_DEPLOYMENT=YOUR-MODEL-DEPLOYMENT-NAME
